import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

fn literal(hex : String) -> String {
  if hex.length() >= 128 {
    for width in [2, 4, 6, 8, 10, 12, 14, 16] {
      let pattern = hex[:width].to_owned()
      let copies = hex.length() / width
      let tail = hex[copies * width:].to_owned()
      if pattern.repeat(copies) + tail == hex {
        return literal(pattern) + ".repeat(\{copies})" + (if tail.is_empty() { "" } else { " + " + literal(tail) })
      }
    }
    // Long D strings have a single embedded terminator.
    if hex.has_prefix("44") && hex.has_suffix("44") {
      let pieces = hex.split("00").to_array()
      if pieces.length() == 2 && pieces[0].length() % 2 == 0 && pieces[1].length() % 2 == 0 {
        if pieces[0] == "44".repeat(pieces[0].length() / 2) && pieces[1] == "44".repeat(pieces[1].length() / 2) {
          return literal(pieces[0].to_owned()) + " + b\"\\x00\" + " + literal(pieces[1].to_owned())
        }
      }
    }
  }
  let out = StringBuilder()
  out.write_string("b\"")
  for i in 0..<(hex.length() / 2) {
    out.write_string("\\x")
    out.write_string(hex[i * 2:i * 2 + 2].to_owned())
  }
  out.write_string("\"")
  out.to_string()
}

async fn main {
  let args = @env.args()
  guard args.length() == 4 else { fail("usage: fixtures.mbtx ABSOLUTE_UPSTREAM INPUT_JSON OUTPUT_MBT") }
  let rev = @shell.Cmd("git", ["-c", "safe.directory=" + args[1], "-C", args[1], "rev-parse", "HEAD"]).output()
  rev.check()
  guard rev.stdout().trim() == "518c13904fc32e7f2cc88c9dec934e509062953e" else { fail("wrong upstream revision") }
  let clean = @shell.Cmd("git", ["-c", "safe.directory=" + args[1], "-C", args[1], "diff", "--exit-code", "HEAD", "--", "boofuzz"]).output()
  clean.check()
  let input = @fs.read_file(args[2])
  guard @json.parse(input.text()) is Array(cases) else { fail("expected cases array") }
  let out = StringBuilder()
  out.write_string("// Generated by scripts/fixtures.mbtx from boofuzz 518c13904fc32e7f2cc88c9dec934e509062953e.\n// GPL-2.0-only; input definitions and source paths are in fixtures/.\n")
  for case in cases {
    guard case is { "name": String(name), "moon": String(moon), "python": String(python), .. } else { fail("invalid case") }
    // Minimal foreign-language adapter calls upstream code; all orchestration is MoonBit.
    let adapter = "import sys,json; sys.path.insert(0,sys.argv[1]); from boofuzz import *; p=" + python + "; print(json.dumps([p.render().hex(), [p.encode(m[0].value(p.original_value()) if callable(m[0].value) else m[0].value, None).hex() for m in p.get_mutations()]]))"
    let result = @shell.Cmd("python", ["-c", adapter, args[1]]).output(max_output_bytes=512 * 1024 * 1024)
    result.check()
    guard @json.parse(result.stdout()) is [String(default_hex), Array(values)] else { fail("invalid oracle result") }
    out.write_string("\n///|\ntest \"upstream " + name + "\" {\n  let field = " + moon + "\n  assert_eq(field.default_value(), " + literal(default_hex) + ")\n  let expected : Array[Bytes] = [\n")
    for value in values {
      guard value is String(hex) else { fail("expected hex string") }
      out.write_string("    " + literal(hex) + ",\n")
    }
    out.write_string("  ]\n  assert_eq(field.num_mutations(), expected.length())\n  for i, value in expected { assert_eq(field.mutation(i), Some(value)) }\n}\n")
  }
  @fs.write_file(args[3], out.to_string())
}
