import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
}

async fn main {
  for args in [["fmt"], ["info"], ["info", "--target", "native"], ["check", "--deny-warn"], ["build"], ["test", "--deny-warn"], ["check", "--target", "native", "--deny-warn"], ["build", "--target", "native"], ["test", "--target", "native", "--deny-warn"], ["fmt", "--check"]] {
    println("moon " + args.join(" "))
    @shell.Cmd("moon", args).run()
  }
  for pkg_name in ["transport", "runner", "recordio", "process"] {
    let source = "_build/native/debug/check/" + pkg_name + "/" + pkg_name + ".mbti"
    if @fs.exists(source) { @fs.write_file("docs/" + pkg_name + ".native.mbti", @fs.read_file(source)) }
  }
}
