import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}
async fn main {
  let args = @env.args()
  guard args.length() == 2 else { fail("usage: asan.mbtx ABSOLUTE_PROJECT_ROOT (GCC/Clang toolchain required)") }
  let path = args[1] + "/transport/moon.pkg"
  let original = (@fs.read_file(path)).text()
  defer @fs.write_file(path, original)
  let config = original.replace(old="options(", new="options(link: { \"native\": { \"cc-flags\": \"-g -fsanitize=address -fno-omit-frame-pointer\", \"stub-cc-flags\": \"-g -fsanitize=address -fno-omit-frame-pointer\" } }, ")
  guard config != original else { fail("could not locate native-stub options") }
  @fs.write_file(path, config)
  @shell.Cmd("moon", ["test", "--target", "native", "--target-dir", args[1] + "/_build/asan", "-p", "transport", "--deny-warn"], cwd=args[1]).run()
}
