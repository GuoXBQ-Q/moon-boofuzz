import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}
async fn main {
  let args = @env.args()
  guard args.length() == 2 else { fail("usage: native-info.mbtx ABSOLUTE_PROJECT_ROOT") }
  @shell.Cmd("moon", ["info", "--target", "native"], cwd=args[1]).run()
  let native = @fs.read_file(args[1] + "/_build/native/debug/check/transport/transport.mbti")
  @fs.write_file(args[1] + "/docs/transport.native.mbti", native)
}
