    b"\x44".repeat(970) +
    b"\x00" +
    b"\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44",
    b"\x44".repeat(605) + b"\x00" + b"\x44".repeat(418),
    b"\x44".repeat(1679) + b"\x00" + b"\x44".repeat(368),
    b"\x44".repeat(2026) +
    b"\x00" +
    b"\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44\x44",
    b"\x44".repeat(3282) + b"\x00" + b"\x44".repeat(813),
    b"\x44".repeat(3240) + b"\x00" + b"\x44".repeat(855),
    b"\x44".repeat(22034) + b"\x00" + b"\x44".repeat(10733),
    b"\x44".repeat(14999) + b"\x00" + b"\x44".repeat(17768),
    b"\x44".repeat(64351) + b"\x00" + b"\x44".repeat(1183),
    b"\x44".repeat(58963) + b"\x00" + b"\x44".repeat(6571),
    b"\x44".repeat(52533) + b"\x00" + b"\x44".repeat(13001),
    b"\x44".repeat(50699) + b"\x00" + b"\x44".repeat(14835),
  ]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream delimiter space" {
  let field = @moon_boofuzz.Field::delimiter(" ")
  assert_eq(field.default_value(), b"\x20")
  let expected : Array[Bytes] = [
    b"\x20\x20",
    b"\x20\x20\x20\x20\x20",
    b"\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20",
    b"\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20",
    b"\x20".repeat(100),
    b"\x20".repeat(500),
    b"\x20".repeat(1000),
    b"",
    b"\x09",
    b"\x09\x09",
    b"\x09".repeat(100),
    b"\x20",
    b"\x09",
    b"\x09\x20".repeat(100),
    b"\x09\x0d\x0a".repeat(100),
    b"\x21",
    b"\x40",
    b"\x23",
    b"\x24",
    b"\x25",
    b"\x5e",
    b"\x26",
    b"\x2a",
    b"\x28",
    b"\x29",
    b"\x7b",
    b"\x7d",
    b"\x5b",
    b"\x5d",
    b"\x2d",
    b"\x5f",
    b"\x2b",
    b"\x3d",
    b"\x3a",
    b"\x3a\x20".repeat(100),
    b"\x3a\x37".repeat(100),
    b"\x3b",
    b"\x27",
    b"\x22",
    b"\x2f",
    b"\x5c",
    b"\x3f",
    b"\x3c",
    b"\x3e",
    b"\x2e",
    b"\x2c",
    b"\x0d",
    b"\x0a",
    b"\x0d\x0a".repeat(64),
    b"\x0d\x0a".repeat(128),
    b"\x0d\x0a".repeat(512),
  ]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

