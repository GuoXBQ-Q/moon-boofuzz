///|
test "upstream simple binary" {
  let field = @moon_boofuzz.Field::simple(b"A", [b"", b"\x00\xff", b"\x00\xff"])
  assert_eq(field.default_value(), b"\x41")
  let expected : Array[Bytes] = [b"", b"\x00\xff", b"\x00\xff"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream group duplicates" {
  let field = @moon_boofuzz.Field::group([b"A", b"B", b"A", b"B"])
  assert_eq(field.default_value(), b"\x41")
  let expected : Array[Bytes] = [b"\x42", b"\x41", b"\x42"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream group explicit default" {
  let field = @moon_boofuzz.Field::group([b"A", b"B", b"B"], default_value=b"B")
  assert_eq(field.default_value(), b"\x42")
  let expected : Array[Bytes] = [b"\x41", b"\x42"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream group missing default" {
  let field = @moon_boofuzz.Field::group([b"A"], default_value=b"C")
  assert_eq(field.default_value(), b"\x43")
  let expected : Array[Bytes] = [b"\x41"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream group disabled" {
  let field = @moon_boofuzz.Field::group([b"A", b"B"], fuzzable=false)
  assert_eq(field.default_value(), b"\x41")
  let expected : Array[Bytes] = []
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}
