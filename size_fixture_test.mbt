///|
test "upstream size dynamic bytes" {
  let field = request_fixture(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        @moon_boofuzz.Node::size(
          "len",
          "r.body",
          length=2,
          endian=Big,
          offset=1,
          inclusive=true,
        ),
        Nested(
          @moon_boofuzz.Block::new("body", [
            Leaf("x", @moon_boofuzz.Field::simple(b"AB", [b"CDE"])),
          ]),
        ),
      ]),
    ),
  )
  assert_eq(field.default_value(), b"\x00\x05\x41\x42")
  let expected : Array[Bytes] = [b"\x00\x06\x43\x44\x45"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

