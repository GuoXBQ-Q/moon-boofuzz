///|
test "upstream repeat sequence" {
  let field = request_fixture(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        Nested(
          @moon_boofuzz.Block::new("item", [
            Leaf("x", @moon_boofuzz.Field::simple(b"AB", [])),
          ]),
        ),
        @moon_boofuzz.Node::repeat("copies", "r.item", min=0, max=4, step=2),
      ]),
    ),
  )
  assert_eq(field.default_value(), b"\x41\x42")
  let expected : Array[Bytes] = [
    b"\x41\x42", b"\x41\x42\x41\x42\x41\x42", b"\x41\x42\x41\x42\x41\x42\x41\x42\x41\x42",
  ]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream conditional switching" {
  let field = request_fixture(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        Leaf("flag", @moon_boofuzz.Field::simple(b"0", [b"1", b"0"])),
        Nested(
          @moon_boofuzz.Block::new("body", [
            Leaf("x", @moon_boofuzz.Field::simple(b"X", [])),
          ]).when(Equal("r.flag", b"1")),
        ),
      ]),
    ),
  )
  assert_eq(field.default_value(), b"\x30")
  let expected : Array[Bytes] = [b"\x31\x58", b"\x30"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}
