  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream binary zero size" {
  let field = @moon_boofuzz.Field::binary(b"ABC", size=0)
  assert_eq(field.default_value(), b"\x41\x42\x43")
  let expected : Array[Bytes] = [
    b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"",
    b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"",
    b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"",
    b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"",
    b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"", b"",
    b"", b"", b"", b"", b"", b"", b"", b"",
  ]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}
