///|
test "upstream aligned empty" {
  let field = @moon_boofuzz.Field::simple(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", []).aligned(4, pattern=b"AB"),
    ).render(),
    [],
  )
  assert_eq(field.default_value(), b"\x41\x42\x41\x42")
  let expected : Array[Bytes] = []
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream aligned exact" {
  let field = @moon_boofuzz.Field::simple(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        Leaf("x", @moon_boofuzz.Field::simple(b"1234", [])),
      ]).aligned(4, pattern=b"AB"),
    ).render(),
    [],
  )
  assert_eq(field.default_value(), b"\x31\x32\x33\x34\x41\x42\x41\x42")
  let expected : Array[Bytes] = []
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

