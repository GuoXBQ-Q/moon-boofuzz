///|
test "upstream checksum payload mutations" {
  let field = request_fixture(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        @moon_boofuzz.Node::checksum("crc", "r.body", endian=Big),
        Nested(
          @moon_boofuzz.Block::new("body", [
            Leaf("x", @moon_boofuzz.Field::simple(b"123456789", [b""])),
          ]),
        ),
      ]),
    ),
  )
  assert_eq(
    field.default_value(),
    b"\xcb\xf4\x39\x26\x31\x32\x33\x34\x35\x36\x37\x38\x39",
  )
  let expected : Array[Bytes] = [b"\x00\x00\x00\x00"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}

///|
test "upstream checksum and parent size" {
  let field = request_fixture(
    @moon_boofuzz.CompiledRequest::compile(
      @moon_boofuzz.Block::new("r", [
        @moon_boofuzz.Node::size("len", "r", length=1),
        @moon_boofuzz.Node::checksum("crc", "r"),
        Leaf("x", @moon_boofuzz.Field::simple(b"A", [b"BB"])),
      ]),
    ),
  )
  assert_eq(field.default_value(), b"\x06\xb8\x33\x40\x66\x41")
  let expected : Array[Bytes] = [b"\x07\xcb\xec\x56\x02\x42\x42"]
  assert_eq(field.num_mutations(), expected.length())
  for i, value in expected {
    assert_eq(field.mutation(i), Some(value))
  }
}
